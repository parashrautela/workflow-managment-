{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://workflow-managment-production.up.railway.app/api/:path*"
    },
    {
      "source": "/c/:token",
      "destination": "/client.html"
    },
    {
      "source": "/employee",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    }
  ]
}
