DATABASE_URL=
# Optional first-install bootstrap only; ignored once an approved founder exists.
INITIAL_FOUNDER_EMAIL=
# Birthday screen: Google sign-in emails that see it (comma-separated). Off when empty.
BIRTHDAY_EMAILS=

# OpenAI Integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# Optional: another OpenAI-compatible endpoint for the founder Assistant (default https://api.openai.com/v1).
OPENAI_BASE_URL=
# Off by default. Set to true (with OPENAI_API_KEY) to let the founder Assistant use an AI model; it then sends the question and needed project records, without contact details, to that provider.
FOUNDER_AI_ASSISTANT_ENABLED=
# Off by default. Set to true (with OPENAI_API_KEY) to transcribe clients' voice notes; the recording is sent to the AI provider and the text keeps the language spoken.
VOICE_TRANSCRIPT_ENABLED=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
INTEGRATION_SHARED_SECRET=
GROUP_BOT_TOKEN=
BOT_BRIDGE_URL=

# Figma Integration Credentials
# Get your token from: https://www.figma.com/settings (under 'Personal access tokens')
FIGMA_ACCESS_TOKEN=
FIGMA_PERSONAL_ACCESS_TOKEN=

# Project Figma Board
FIGMA_BOARD_URL=https://www.figma.com/board/UWscIC0R0NrqZyKUmmuGEB/Untitled?node-id=0-1&t=EMt7WHN72keLxW68-1
FIGMA_FILE_KEY=UWscIC0R0NrqZyKUmmuGEB

# Public Google Identity Services web client ID. Sign-in needs only this.
GOOGLE_CLIENT_ID=
# Google Drive page: the same OAuth client's secret lets a founder connect Drive (drive.file scope).
# It also seals the stored Drive token, so changing it means reconnecting Drive.
GOOGLE_CLIENT_SECRET=
# Browser API key for Google's folder picker (Choose / Paste a folder). Restrict it to the app's web origin.
GOOGLE_PICKER_API_KEY=
